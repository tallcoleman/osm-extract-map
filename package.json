{
  "name": "osm-extract-map",
  "version": "0.0.0",
  "private": true,
  "description": "Web map showing the bounds of extracts offered by Geofabrik and OSM-FR",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "tsc --noEmit && tsc --noEmit -p web && npm run lint",
    "dev": "vite --config web/vite.config.ts",
    "recon": "node updater/explore/recon.ts",
    "update-data": "node updater/cli.ts",
    "lint": "oxlint",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "polyclip-ts": "0.16.8",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "26.5.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "4.14.0",
    "fast-check": "^4.10.2",
    "jsdom": "30.1.3",
    "maplibre-gl": "^6.16.0",
    "oxlint": "1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
