{
  "name": "osm-extract-map",
  "version": "0.0.0",
  "private": true,
  "description": "Web map showing the bounds of extracts offered by Geofabrik and OSM-FR",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "tsc --noEmit && tsc --noEmit -p web",
    "dev": "vite --config web/vite.config.ts",
    "recon": "node updater/explore/recon.ts",
    "update-data": "node updater/cli.ts"
  },
  "dependencies": {
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
